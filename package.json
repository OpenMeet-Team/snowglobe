{
  "name": "@openmeet/snowglobe",
  "version": "0.5.0",
  "description": "Standalone, testable ATProto development network for local development and CI",
  "type": "module",
  "bin": {
    "snowglobe": "bin/snowglobe.mjs"
  },
  "license": "MIT",
  "author": "OpenMeet Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/OpenMeet-Team/snowglobe.git"
  },
  "homepage": "https://snowglobe.at",
  "keywords": [
    "atproto",
    "bluesky",
    "pds",
    "jetstream",
    "docker",
    "development",
    "testing"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@atproto/api": "^0.15.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@peculiar/asn1-schema": "^2.11.0",
    "@peculiar/asn1-x509": "^2.11.0",
    "@peculiar/x509": "2.2.0",
    "reflect-metadata": "0.2.2",
    "yaml": "^2.9.1"
  },
  "files": [
    "bin/",
    "lib/",
    "stack/",
    "!stack/**/*.test.mjs",
    "snowglobe.default.yml",
    ".env.example"
  ],
  "publishConfig": {
    "access": "public"
  }
}
